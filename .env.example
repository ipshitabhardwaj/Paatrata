# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
# Exact model ids: check https://aistudio.google.com (models list). Defaults shown.
GEMINI_MODEL=gemini-3.8-flash
GEMMA_MODEL=gemma-4-31b-it
# Local Gemma via Ollama (run `ollama list` to see the exact tag you pulled)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b
# Officer token for compile/resolve/approve (change it before deploying)
ADMIN_TOKEN=dev-token
DB_PATH=data/paatrata.db
UPLOAD_DIR=data/uploads
PAATRATA_CACHE_DIR=evaluation/cache
CORS_ORIGIN=https://your-app.onrender.com
